ZKGMAIL_IMAP_HOST=imap.qq.com
ZKGMAIL_IMAP_PORT=993
ZKGMAIL_IMAP_USERNAME=receiver@example.com
ZKGMAIL_IMAP_PASSWORD=replace-with-imap-authorization-code
ZKGMAIL_IMAP_FOLDER=INBOX
ZKGMAIL_TRUSTED_RECIPIENT_HEADER=X-Original-To
ZKGMAIL_IMAP_MAX_CONCURRENT_QUERIES=2
ZKGMAIL_LOOKBACK_MINUTES=30
ZKGMAIL_FETCH_LIMIT=50
ZKGMAIL_CACHE_TTL_SECONDS=2
ZKGMAIL_RATE_LIMIT_REQUESTS=30
ZKGMAIL_RATE_LIMIT_WINDOW_SECONDS=60
ZKGMAIL_ACCESS_TOKEN=replace-with-64-hex-characters-from-secrets-token-hex-32
ZKGMAIL_REQUIRE_INVITE=true
ZKGMAIL_SESSION_MAX_AGE_SECONDS=604800
ZKGMAIL_SESSION_MAX_SESSIONS=4096
ZKGMAIL_SESSION_MAX_PER_INVITE=8
ZKGMAIL_SESSION_STORE_PATH=/data/access_sessions.json
ZKGMAIL_ACCESS_RATE_LIMIT_REQUESTS=10
ZKGMAIL_ACCESS_RATE_LIMIT_WINDOW_SECONDS=600
ZKGMAIL_RATE_LIMIT_MAX_KEYS=4096
