+    if "@" in domain:
+        domain = domain.rsplit("@", 1)[-1]
+    if len(domain) > 253 or not re.fullmatch(
+        r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?"
+        r"(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+",
+        domain,
+    ):
+        raise ValueError("请输入有效的邮箱域名，例如 cclgmail.com")
+    return domain
