+@dataclasses.dataclass(frozen=True)
+class OpllTransientRequestRetryPolicy:
+    """Strategy for bounded, in-place retries before a payment mutation."""
+
+    attempts: int = 2
+    retry_delays: tuple[float, ...] = (1.0,)
+    retryable_statuses: frozenset[int] = frozenset({500, 502, 503, 504})
+
+    def delay_after(self, attempt_index: int) -> float:
+        if attempt_index < len(self.retry_delays):
+            return max(0.0, float(self.retry_delays[attempt_index]))
+        return 0.0
+
+    def retries_status(self, status_code: int) -> bool:
+        return int(status_code or 0) in self.retryable_statuses
+
+
+OPLL_TRANSIENT_REQUEST_RETRY = OpllTransientRequestRetryPolicy()
