+) -> str:
+    """Validate the nested Stripe-to-ChatGPT GB return URL contract."""
+
+    value = str(return_url or "").strip()
+    parsed = urlsplit(value)
+    if parsed.scheme != "https" or parsed.netloc != "checkout.stripe.com":
+        raise RuntimeError(
+            "PayPal GB Confirm return_url must use checkout.stripe.com"
+        )
+    if parsed.path != f"/c/pay/{str(cs_id or '').strip()}":
+        raise RuntimeError("PayPal GB Confirm return_url has the wrong Checkout path")
+    query = parse_qs(parsed.query, keep_blank_values=True)
+    if set(query) != {"returned_from_redirect", "ui_mode", "return_url"}:
+        raise RuntimeError(
+            "PayPal GB Confirm return_url must contain only "
