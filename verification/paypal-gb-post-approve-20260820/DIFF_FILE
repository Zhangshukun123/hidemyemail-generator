+def opll_paypal_gb_confirm_return_url(
+    cs_id: str,
+    checkout: dict,
+    stripe_hosted_url: str,
+) -> str:
+    """Build the exact hosted Stripe return URL used by the GB flow."""
+
+    checkout_id = str(cs_id or "").strip()
+    if not checkout_id.startswith("cs_"):
+        raise RuntimeError(
+            "PayPal GB Confirm 缺少有效 Stripe Checkout Session ID"
+        )
+    success_url = opll_chatgpt_success_return_url(
+        checkout_id,
+        str((checkout or {}).get("billing_country") or "GB"),
+        str((checkout or {}).get("processor_entity") or ""),
+    )
+    hosted_url = str(stripe_hosted_url or "").strip()
+    try:
+        parsed = urlsplit(hosted_url)
+        valid_hosted_url = bool(
+            parsed.scheme.lower() == "https"
+            and parsed.hostname == "checkout.stripe.com"
+            and parsed.username is None
+            and parsed.password is None
+            and parsed.port is None
+            and parsed.path == f"/c/pay/{checkout_id}"
+        )
+    except ValueError:
+        parsed = None
+        valid_hosted_url = False
+    if not valid_hosted_url or parsed is None:
+        raise RuntimeError(
+            "PayPal GB Confirm 的 Stripe hosted URL 与当前 Checkout "
+            "Session 不匹配"
+        )
+    query = urlencode(
+        (
+            ("returned_from_redirect", "true"),
+            ("ui_mode", "custom"),
+            ("return_url", success_url),
+        )
+    )
+    return urlunsplit(
+        (
+            "https",
+            parsed.netloc,
+            parsed.path,
+            query,
+            parsed.fragment,
+        )
+    )
